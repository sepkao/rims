# API URL shared by the Internal app during local/LAN development.
VITE_API_URL=http://localhost:3000

# Public base URL of the Customer app. Required for Cashier QR codes.
# Local: http://localhost:5173 (same machine) or http://<LAN-IP>:5173 (phone on same network).
# Production: use the deployed HTTPS Customer URL; do not leave localhost.
VITE_CUSTOMER_APP_URL=http://localhost:5173
# PromptPay mobile number or tax ID used to receive payments. Do not commit
# the real recipient ID; put it in apps/internal/.env or deployment secrets.
VITE_PROMPTPAY_ID=
