DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SESSION_SECRET=replace-with-a-long-random-secret

# Comma-separated browser origins allowed to call the API. Add the Customer
# and Internal URLs used on your LAN or in production; do not add a wildcard.
CORS_ALLOWED_ORIGINS=http://<LAN-IP>:5173,http://<LAN-IP>:5174
