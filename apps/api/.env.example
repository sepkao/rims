DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# API-side PostgreSQL pool. Tune against the connection limit of the deployed database.
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
SESSION_SECRET=replace-with-a-long-random-secret

# Comma-separated browser origins allowed to call the API. Add the Customer
# and Internal URLs used on your LAN or in production; do not add a wildcard.
CORS_ALLOWED_ORIGINS=http://<LAN-IP>:5173,http://<LAN-IP>:5174

# Menu image storage (Supabase Storage). Create a PUBLIC bucket named
# "menu-images" in the Supabase dashboard, then set these from
# Project Settings > API. Use the "service_role" / "Secret" key here,
# never the anon/publishable key — never commit real values or expose
# this key to the frontend.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-secret
