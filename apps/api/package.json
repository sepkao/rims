{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "cashier:p0": "node scripts/cashier-p0.mjs",
    "cashier:p0:check": "node scripts/cashier-p0.mjs --check",
    "cashier:p0:smoke": "node scripts/cashier-p0-smoke.mjs --allow-temporary-data",
    "test": "tsc && node --test dist/inventory-transfer.test.js dist/inventory-intake.test.js dist/cashier-payment.test.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.9",
    "bcryptjs": "^3.0.3",
    "hono": "^4.12.30",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.21.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
